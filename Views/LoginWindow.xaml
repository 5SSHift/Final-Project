<Window x:Class="Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Wpf.Converters"
        Title="ShopManager — Autentificare"
        Height="536" Width="420"
        Icon="/Resources/icon.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EFF6FF">

    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Input" TargetType="Control">
            <Setter Property="Height"                   Value="40"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#111827"/>
            <Setter Property="BorderBrush"              Value="#D1D5DB"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height"          Value="40"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="#2563EB"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E5E7EB"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="0,0,0,25">
        <!-- Top accent line -->
        <Border VerticalAlignment="Top" Height="3" Background="#2563EB"/>

        <!-- Card -->
        <Border Background="White" Margin="32,32,32,14" CornerRadius="10"
                BorderBrush="#E5E7EB" BorderThickness="1"
                Padding="36,32">
            <StackPanel>
                <TextBlock Text="{DynamicResource App_Name}" FontSize="20" FontWeight="Bold"
                           Foreground="#111827" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Login_Subtitle}"
                           FontSize="12" Foreground="#6B7280"
                           HorizontalAlignment="Center" Margin="0,4,0,28"/>

                <TextBlock Text="{DynamicResource Login_Username}" Style="{StaticResource Lbl}"/>
                <TextBox x:Name="TxtUsername" Style="{StaticResource Input}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,14"/>

                <TextBlock Text="{DynamicResource Login_Password}" Style="{StaticResource Lbl}"/>
                <PasswordBox x:Name="PbxPassword" Style="{StaticResource Input}" Margin="0,0,0,22"/>

                <Button x:Name="btnLogin" Content="{DynamicResource Login_Button}" Style="{StaticResource PrimaryBtn}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}"
                        Click="BtnLogin_Click"/>

                <ProgressBar Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             IsIndeterminate="True" Height="2" Margin="0,8,0,0"
                             Foreground="#2563EB" Background="Transparent" BorderThickness="0"/>

                <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                        Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                        Padding="12,8" Margin="0,10,0,0" CornerRadius="6">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626"
                               FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <TextBlock HorizontalAlignment="Center" Margin="0,18,0,0"
                           FontSize="12" Foreground="#6B7280">
                    Nu ai un cont?
                    <Hyperlink Foreground="#2563EB" Command="{Binding OpenRegisterCommand}">Înregistrează-te</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
