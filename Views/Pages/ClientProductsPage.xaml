<Page x:Class="Wpf.Views.Pages.ClientProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:Wpf.Converters"
      Background="#EFF6FF" Title="Magazin">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:GreaterThanZeroConverter x:Key="GtZero"/>

        <Style x:Key="CategoryTagFilter" TargetType="CheckBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="FilterBorder"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FilterBorder" Property="Background" Value="#DBEAFE"/>
                                <Setter TargetName="FilterBorder" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="FilterBorder" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="FilterBorder" Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CartBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">

            <DockPanel Margin="0,0,0,20">
                <TextBlock DockPanel.Dock="Left" Text="Magazin" FontSize="22" FontWeight="Bold"
                           Foreground="#111827" Width="132"/>

                <Button DockPanel.Dock="Right" Click="ViewCart_Click"
                        Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                        Padding="14,0" Height="36" Cursor="Hand" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛒" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Foreground="#374151" FontSize="13"
                                   Margin="6,0,0,0" VerticalAlignment="Center">
                            <Run Text="{DynamicResource Cart_Button}"/>
                            <Run Text=" ("/>
                            <Run Text="{Binding Cart.ItemCount, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                        <Border Background="#2563EB" CornerRadius="10" Padding="7,2"
                                Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding Cart.ItemCount, Converter={StaticResource GtZero}}">
                            <TextBlock Text="{Binding Cart.Total, StringFormat=C2}"
                                       Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Button>

                <Border DockPanel.Dock="Right" Background="White" BorderBrush="#E5E7EB"
                        BorderThickness="1" CornerRadius="6" Padding="10,0"
                        Height="36" MinWidth="220" Margin="0,0,12,0" Width="319">
                    <Grid>
                        <TextBlock Text="Caută produse..." Foreground="#9CA3AF" FontSize="13"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" Foreground="#111827" Background="Transparent"
                                 BorderThickness="0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </DockPanel>

            <ItemsControl x:Name="CategoriesPanel" Margin="0,0,0,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <DockPanel Margin="0,0,0,16">
                <TextBlock FontSize="13" Foreground="#6B7280" VerticalAlignment="Center">
                    <Run Text="{Binding FilteredProducts.Count, Mode=OneWay}"/>
                    <Run Text="{DynamicResource Shop_Found}"/>
                </TextBlock>
            </DockPanel>

            <ItemsControl ItemsSource="{Binding FilteredProducts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,14,14" Background="White"
                                BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect Color="#000" Opacity="0.04" BlurRadius="8" ShadowDepth="1"/>
                            </Border.Effect>
                            <StackPanel>
                                <Border Height="180" CornerRadius="10,10,0,0"
                                        Background="#F9FAFB" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding ImageData, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill"/>

                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="10" Padding="7,3" CornerRadius="6"
                                                Background="#EF4444"
                                                Visibility="{Binding IsOnOffer, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding DiscountPercentage, StringFormat='-{0}%'}"
                                                       Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>

                                        <Border CornerRadius="10,10,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Stock}" Value="0">
                                                            <Setter Property="Background" Value="#99000000"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="16" FontWeight="Bold"
                                                       Foreground="White">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value=""/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Stock}" Value="0">
                                                                <Setter Property="Text" Value="Epuizat"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Margin="14,12,14,14">
                                    <Border HorizontalAlignment="Left" Padding="7,2"
                                            CornerRadius="4" Background="#DBEAFE" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Category}" FontSize="10"
                                                   Foreground="#1D4ED8" FontWeight="SemiBold"/>
                                    </Border>

                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#111827" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,5"/>

                                    <TextBlock Text="{Binding Description}" FontSize="12"
                                               Foreground="#6B7280" TextWrapping="Wrap"
                                               MaxHeight="36" TextTrimming="WordEllipsis"
                                               Margin="0,0,0,10"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Foreground="#9CA3AF" FontSize="11"
                                                   TextDecorations="Strikethrough"
                                                   Margin="0,3,6,0"
                                                   Text="{Binding Price, StringFormat=C2}"
                                                   Visibility="{Binding IsOnOffer, Converter={StaticResource BoolToVis}}"/>

                                        <TextBlock Text="{Binding FinalPrice, StringFormat=C2}"
                                                   FontSize="18" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#059669"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnOffer}" Value="True">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock FontSize="11" Foreground="#059669"
                                               Margin="0,0,0,8"
                                               Visibility="{Binding IsOnOffer, Converter={StaticResource BoolToVis}}">
                                        <Run Text="{DynamicResource Cart_SaveAmount}"/>
                                        <Run Text="{Binding DiscountPercentage, StringFormat='{}{0}%'}"/>
                                        <Run Text=" față de prețul normal"/>
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#10B981"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Stock}" Value="0">
                                                            <Setter Property="Fill" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock FontSize="11" Foreground="#6B7280">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Stock, StringFormat='Stoc: {0} buc.'}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Stock}" Value="0">
                                                            <Setter Property="Text" Value="Stoc epuizat"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#2563EB" 
                                            BorderBrush="#2563EB"
                                            Foreground="White"
                                            BorderThickness="1"
                                            Padding="14,0" 
                                            Height="36" 
                                            Cursor="Hand" 
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🛒" FontSize="13" Margin="0,0,6,0"/>
                                            <TextBlock Text="Adaugă în coș" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ProgressBar Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         IsIndeterminate="True" Height="3" Margin="0,12,0,0"
                         Foreground="#2563EB" Background="Transparent" BorderThickness="0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
