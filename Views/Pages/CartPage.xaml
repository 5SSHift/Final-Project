<Page x:Class="Wpf.Views.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:Wpf.Converters"
      Background="#EFF6FF" Title="Coș de cumpărături">

    <Page.Resources>
        <Style x:Key="QtyBtn" TargetType="Button">
            <Setter Property="Width"           Value="30"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Background"      Value="#F3F4F6"/>
            <Setter Property="Foreground"      Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#E5E7EB"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E7EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height"          Value="42"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="#2563EB"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E5E7EB"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Height"          Value="38"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#D1D5DB"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="32,24,32,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT: Cart items ═══ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{DynamicResource Cart_Title}" FontSize="22" FontWeight="Bold"
                           Foreground="#111827" VerticalAlignment="Center"/>
                <Border Background="#DBEAFE" BorderBrush="#93C5FD" BorderThickness="1"
                        Padding="10,3" Margin="12,0,0,0" CornerRadius="12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} produse'}"
                               Foreground="#1D4ED8" FontSize="12" FontWeight="Bold"/>
                </Border>
                <Button DockPanel.Dock="Right" Content="{DynamicResource Cart_Clear}" HorizontalAlignment="Right"
                        Style="{StaticResource SecBtn}" Padding="14,0"
                        Command="{Binding ClearCommand}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}"/>
            </DockPanel>

            <!-- Empty state -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="🛒" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="{DynamicResource Cart_Empty}" FontSize="16" FontWeight="SemiBold"
                           Foreground="#374151" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Cart_EmptySub}"
                           FontSize="13" Foreground="#9CA3AF"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Items list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                    CornerRadius="10" Margin="0,0,0,12" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail -->
                                    <Border Grid.Column="0" Width="64" Height="64"
                                            CornerRadius="8" Background="#F9FAFB"
                                            ClipToBounds="True">
                                        <Image Source="{Binding ImageData, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Name + category + price -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                Margin="14,0,12,0">
                                        <TextBlock Text="{Binding ProductName}" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="#111827"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border HorizontalAlignment="Left" Padding="6,2"
                                                CornerRadius="4" Background="#DBEAFE" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Category}" FontSize="10"
                                                       Foreground="#1D4ED8" FontWeight="SemiBold"/>
                                        </Border>
                                        <!-- Unit price with optional strikethrough -->
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock FontSize="11" Foreground="#9CA3AF"
                                                       TextDecorations="Strikethrough"
                                                       Margin="0,1,6,0"
                                                       Text="{Binding OriginalPrice, StringFormat=C2}"
                                                       Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding UnitPrice, StringFormat=C2}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#059669"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Quantity +/- -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="8,0">
                                        <Button Style="{StaticResource QtyBtn}" Content="−"
                                                Command="{Binding DataContext.DecreaseCommand,
                                                          RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock Text="{Binding Quantity}" FontSize="14"
                                                   FontWeight="Bold" Foreground="#111827"
                                                   Width="36" TextAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource QtyBtn}" Content="+"
                                                Command="{Binding DataContext.IncreaseCommand,
                                                          RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>

                                    <!-- Line total + savings -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding LineTotal, StringFormat=C2}"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="#111827" TextAlignment="Right"/>
                                        <TextBlock FontSize="11" Foreground="#10B981"
                                                   TextAlignment="Right"
                                                   Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}">
                                            <Run Text="{DynamicResource Cart_Economy}"/>
                                            <Run Text="{Binding LineSavings, StringFormat=C2, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Remove button -->
                                    <Button Grid.Column="4" Content="✕" Width="28" Height="28"
                                            Margin="10,0,0,0" Background="Transparent"
                                            BorderThickness="0" Foreground="#9CA3AF"
                                            Cursor="Hand" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveCommand,
                                                      RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Status message -->
            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontSize="12"
                       Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#6B7280"/>
        </Grid>

        <!-- ═══ RIGHT: Summary + checkout ═══ -->
        <StackPanel Grid.Column="2" VerticalAlignment="Top">

            <!-- Order summary -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="10" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Cart_Summary}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#111827" Margin="0,0,0,16"/>

                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource Cart_Subtotal}" Foreground="#6B7280" FontSize="13"/>
                        <TextBlock Text="{Binding Subtotal, StringFormat=C2}"
                                   DockPanel.Dock="Right" FontSize="13" Foreground="#111827" Width="196"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,8"
                               Visibility="{Binding HasSavings, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Cart_Discounts}" Foreground="#059669" FontSize="13"/>
                        <TextBlock DockPanel.Dock="Right" FontSize="13" Foreground="#059669" Width="196">
                            <Run Text="−"/>
                            <Run Text="{Binding Savings, StringFormat=C2, Mode=OneWay}"/>
                        </TextBlock>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource Cart_Delivery}" Foreground="#6B7280" FontSize="13"/>
                        <TextBlock Text="{DynamicResource Cart_Free}" DockPanel.Dock="Right"
                                   FontSize="13" Foreground="#059669" FontWeight="SemiBold" Width="187"/>
                    </DockPanel>

                    <Separator Background="#E5E7EB" Margin="0,0,0,12"/>

                    <DockPanel>
                        <TextBlock Text="{DynamicResource Cart_Total}" Foreground="#111827" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Total, StringFormat=C2}"
                                   DockPanel.Dock="Right" FontSize="20" FontWeight="Bold"
                                   Foreground="#2563EB" Width="203"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Checkout form -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Cart_DeliveryInfo}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#111827" Margin="0,0,0,16"/>

                    <TextBlock Text="{DynamicResource Cart_Address}" FontSize="11" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding ShippingAddress, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" Background="White" Foreground="#111827"
                             BorderBrush="#D1D5DB" BorderThickness="1"
                             Padding="10,8" Height="72" TextWrapping="Wrap"
                             AcceptsReturn="True" Margin="0,0,0,14"/>

                    <TextBlock Text="{DynamicResource Cart_Payment}" FontSize="11" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding PaymentOptions}"
                              SelectedItem="{Binding SelectedPayment}"
                              FontSize="13" Height="36" Padding="10,0"
                              Background="White" BorderBrush="#D1D5DB"
                              BorderThickness="1" Margin="0,0,0,18"/>

                    <Button Content="{DynamicResource Cart_PlaceOrder}"
                            Style="{StaticResource PrimaryBtn}"
                            Command="{Binding PlaceOrderCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}"/>

                    <ProgressBar Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                 IsIndeterminate="True" Height="3" Margin="0,10,0,0"
                                 Foreground="#2563EB" Background="Transparent" BorderThickness="0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
