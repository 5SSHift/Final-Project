<Page x:Class="Wpf.Views.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#EFF6FF" Title="Comenzi">

    <Page.Resources>

        <Style TargetType="DataGrid">
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#111827"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="RowBackground"            Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6"/>
            <Setter Property="ColumnHeaderHeight"       Value="38"/>
            <Setter Property="RowHeight"                Value="40"/>
            <Setter Property="FontSize"                 Value="13"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#F9FAFB"/>
            <Setter Property="Foreground"      Value="#6B7280"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="#E5E7EB"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

        <!-- Butoane toolbar -->
        <Style x:Key="SBtn" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#D1D5DB"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground"  Value="#9CA3AF"/>
                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Acțiuni admin -->
        <Style x:Key="ApproveBtn" TargetType="Button">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Padding"         Value="18,0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="#16A34A"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#15803D"/></Trigger>
                <Trigger Property="IsEnabled"   Value="False"><Setter Property="Background" Value="#BBF7D0"/><Setter Property="Foreground" Value="#6B7280"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DeliverBtn" TargetType="Button">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Padding"         Value="18,0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="#7C3AED"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#6D28D9"/></Trigger>
                <Trigger Property="IsEnabled"   Value="False"><Setter Property="Background" Value="#DDD6FE"/><Setter Property="Foreground" Value="#6B7280"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RejectBtn" TargetType="Button">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Padding"         Value="18,0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#FECACA"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FEF2F2"/></Trigger>
                <Trigger Property="IsEnabled"   Value="False"><Setter Property="Foreground" Value="#9CA3AF"/><Setter Property="BorderBrush" Value="#E5E7EB"/></Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox căutare -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"     Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <TextBlock Text="🔍"
                                           Foreground="#9CA3AF" FontSize="12"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid Margin="32,24,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: header -->
            <RowDefinition Height="Auto"/>  <!-- 1: toolbar + căutare -->
            <RowDefinition Height="*" MinHeight="180"/>  <!-- 2: tabel comenzi -->
            <RowDefinition Height="Auto"/>  <!-- 3: acțiuni admin -->
            <RowDefinition Height="14"/>    <!-- 4: separator -->
            <RowDefinition Height="Auto"/>  <!-- 5: titlu detalii -->
            <RowDefinition Height="160"/>   <!-- 6: detalii produse -->
        </Grid.RowDefinitions>

        <!-- ══ 0. Header ═══════════════════════════════════════════════════════ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Orders_Title}" FontSize="22" FontWeight="Bold"
                       Foreground="#111827" VerticalAlignment="Center"/>
            <Border Background="#DBEAFE" BorderBrush="#93C5FD" BorderThickness="1"
                    Padding="10,3" Margin="12,0,0,0" CornerRadius="12" VerticalAlignment="Center">
                <TextBlock Text="{Binding Orders.Count}" Foreground="#1D4ED8"
                           FontSize="12" FontWeight="Bold"/>
            </Border>
        </DockPanel>

        <!-- ══ 1. Toolbar ══════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Style="{StaticResource SBtn}"
                    Content="{DynamicResource Orders_Refresh}"
                    Command="{Binding RefreshCommand}" Margin="0,0,10,0"/>
            <TextBox Style="{StaticResource SearchBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="380"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#6B7280"
                       FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <!-- ══ 2. Tabel comenzi ════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="10" ClipToBounds="True">
            <DataGrid x:Name="OrdersGrid"
                      ItemsSource="{Binding OrdersView}"
                      SelectedItem="{Binding SelectedOrder}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserSortColumns="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding OrderID}" Width="55"
                                        SortMemberPath="OrderID"/>
                    <DataGridTextColumn Header="{DynamicResource Orders_ColClient}"
                                        Binding="{Binding ClientUsername}" Width="130"
                                        SortMemberPath="ClientUsername"/>
                    <DataGridTextColumn Header="{DynamicResource Orders_ColDate}"
                                        Binding="{Binding OrderDate, StringFormat=dd/MM/yyyy HH:mm}" Width="130"
                                        SortMemberPath="OrderDate"/>

                    <!-- Status tradus cu badge colorat — sortabil pe StatusOrder -->
                    <DataGridTemplateColumn Header="{DynamicResource Orders_ColStatus}" Width="130"
                                            SortMemberPath="StatusOrder">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="4,0"
                                        Background="{Binding Status, Converter={StaticResource StatusToColor}}">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToLocalized}}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="{DynamicResource Orders_ColTotal}"
                                        Binding="{Binding TotalAmount, StringFormat=C2}" Width="100"
                                        SortMemberPath="TotalAmount"/>
                    <DataGridTextColumn Header="{DynamicResource Orders_ColAddress}"
                                        Binding="{Binding ShippingAddress}" Width="*"
                                        SortMemberPath="ShippingAddress"/>
                    <DataGridTextColumn Header="{DynamicResource Orders_ColPayment}"
                                        Binding="{Binding PaymentMethod}" Width="110"
                                        SortMemberPath="PaymentMethod"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Loading overlay -->
        <Grid Grid.Row="2" Background="#EFF6FF" Opacity="0.8"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ProgressBar Width="200" Height="3" IsIndeterminate="True" VerticalAlignment="Center"
                         Foreground="#2563EB" Background="Transparent" BorderThickness="0"/>
        </Grid>

        <!-- ══ 3. Panou acțiuni admin ══════════════════════════════════════════ -->
        <Border Grid.Row="3" Margin="0,10,0,0"
                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="10" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Info comandă selectată -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Foreground="#9CA3AF" FontSize="13" FontStyle="Italic"
                                   Text="Selectează o comandă din tabel pentru a o gestiona."
                                   Visibility="{Binding HasSelectedOrder, Converter={StaticResource InvBoolToVis}}"/>

                        <StackPanel Visibility="{Binding HasSelectedOrder, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="#111827"
                                           Text="{Binding SelectedOrder.OrderID, StringFormat='Comanda #{0}'}"/>
                                <TextBlock Margin="10,0,0,0" FontSize="13" Foreground="#6B7280"
                                           Text="{Binding SelectedOrder.ClientUsername, StringFormat='— {0}'}"/>
                                <Border CornerRadius="4" Padding="8,2" Margin="10,0,0,0"
                                        Background="{Binding SelectedOrder.Status, Converter={StaticResource StatusToColor}}">
                                    <TextBlock Text="{Binding SelectedOrder.Status, Converter={StaticResource StatusToLocalized}}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <TextBlock FontSize="12" Foreground="#6B7280">
                                <Run Text="Total:"/>
                                <Run Text="{Binding SelectedOrder.TotalAmount, StringFormat=C2}" FontWeight="SemiBold"/>
                                <Run Text="  ·  Adresă:"/>
                                <Run Text="{Binding SelectedOrder.ShippingAddress}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- Butoane acțiuni -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Acceptă — Pending -->
                        <Button Style="{StaticResource ApproveBtn}"
                                Command="{Binding ApproveCommand}"
                                IsEnabled="{Binding CanApprove}"
                                Margin="0,0,10,0"
                                Visibility="{Binding CanApprove, Converter={StaticResource BoolToVis}}"
                                ToolTip="Acceptă comanda și scade stocul produselor">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Orders_Approve}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Livrează — Processing -->
                        <Button Style="{StaticResource DeliverBtn}"
                                Command="{Binding DeliverCommand}"
                                IsEnabled="{Binding CanDeliver}"
                                Margin="0,0,10,0"
                                Visibility="{Binding CanDeliver, Converter={StaticResource BoolToVis}}"
                                ToolTip="Marchează comanda ca livrată la client.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Orders_Deliver}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Respinge — Pending / Processing -->
                        <Button Style="{StaticResource RejectBtn}"
                                Command="{Binding RejectCommand}"
                                IsEnabled="{Binding CanReject}"
                                Visibility="{Binding CanReject, Converter={StaticResource BoolToVis}}"
                                ToolTip="Respinge comanda. Dacă era Processing, stocul se restabilește.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Orders_Reject}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ══ 5. Titlu detalii ════════════════════════════════════════════════ -->
        <TextBlock Grid.Row="5" Text="{DynamicResource Orders_Details}" FontSize="13" FontWeight="SemiBold"
                   Foreground="#111827" Margin="0,0,0,8"/>

        <!-- ══ 6. Detalii produse ══════════════════════════════════════════════ -->
        <Border Grid.Row="6" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="10" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Details}" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Orders_ColProduct}"
                                        Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource Orders_ColQty}"
                                        Binding="{Binding Quantity}" Width="90"/>
                    <DataGridTextColumn Header="{DynamicResource Orders_ColUnitPrice}"
                                        Binding="{Binding UnitPrice, StringFormat=C2}" Width="110"/>
                    <DataGridTemplateColumn Header="{DynamicResource Orders_ColSubtotal}" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Margin="14,0"
                                           Text="{Binding Subtotal, StringFormat=C2}"
                                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</Page>
