<Page x:Class="Wpf.Views.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#EFF6FF" Title="Comenzi">
    <Page.Resources>        <Style TargetType="DataGrid">
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#111827"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="RowBackground"            Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6"/>
            <Setter Property="ColumnHeaderHeight"       Value="38"/>
            <Setter Property="RowHeight"                Value="36"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="SelectionMode"            Value="Single"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#F9FAFB"/>
            <Setter Property="Foreground"      Value="#6B7280"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="#E5E7EB"/>
        </Style>
        <Style x:Key="SBtn" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#D1D5DB"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="32,24,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="180"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{DynamicResource Orders_Title}" FontSize="22" FontWeight="Bold"
                       Foreground="#111827" VerticalAlignment="Center"/>
            <Border Background="#DBEAFE" BorderBrush="#93C5FD" BorderThickness="1"
                    Padding="10,3" Margin="12,0,0,0" CornerRadius="12" VerticalAlignment="Center">
                <TextBlock Text="{Binding Orders.Count, StringFormat='{}{0}'}"
                           Foreground="#1D4ED8" FontSize="12" FontWeight="Bold"/>
            </Border>
        </DockPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Style="{StaticResource SBtn}" Content="{DynamicResource Orders_Refresh}"
                    Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#9CA3AF"
                       FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Orders grid -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="10" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Orders}"
                      SelectedItem="{Binding SelectedOrder}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"      Binding="{Binding OrderID}"           Width="60"/>
                    <DataGridTextColumn Header="{DynamicResource Orders_ColClient}"  Binding="{Binding ClientUsername}"    Width="130"/>
                    <DataGridTextColumn Header="{DynamicResource Orders_ColDate}"    Binding="{Binding OrderDate, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
                    <DataGridTextColumn Header="{DynamicResource Orders_ColStatus}"  Binding="{Binding Status}"            Width="110"/>
                    <DataGridTextColumn Header="{DynamicResource Orders_ColTotal}"   Binding="{Binding TotalAmount, StringFormat=C2}" Width="100"/>
                    <DataGridTextColumn Header="{DynamicResource Orders_ColAddress}"  Binding="{Binding ShippingAddress}"   Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource Orders_ColPayment}"   Binding="{Binding PaymentMethod}"     Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Loading overlay -->
        <Grid Grid.Row="2" Background="#EFF6FF" Opacity="0.8"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ProgressBar Width="200" Height="3" IsIndeterminate="True" VerticalAlignment="Center"
                         Foreground="#2563EB" Background="Transparent" BorderThickness="0"/>
        </Grid>

        <!-- Details header -->
        <TextBlock Grid.Row="4" Text="{DynamicResource Orders_Details}" FontSize="13" FontWeight="SemiBold"
                   Foreground="#111827" Margin="0,0,0,8"/>

        <!-- Order details -->
        <Border Grid.Row="5" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="10" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Details}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Orders_ColProduct}"      Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource Orders_ColQty}"   Binding="{Binding Quantity}"    Width="90"/>
                    <DataGridTextColumn Header="{DynamicResource Orders_ColUnitPrice}" Binding="{Binding UnitPrice, StringFormat=C2}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
