<Page x:Class="Wpf.Views.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:Wpf.Converters"
      Background="#EFF6FF" Title="Date Produse">
    <Page.Resources>        <Style TargetType="DataGrid">
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#111827"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="RowBackground"            Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6"/>
            <Setter Property="ColumnHeaderHeight"       Value="38"/>
            <Setter Property="RowHeight"                Value="36"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="SelectionMode"            Value="Single"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#F9FAFB"/>
            <Setter Property="Foreground"      Value="#6B7280"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="#E5E7EB"/>
        </Style>
        <Style x:Key="PBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#E5E7EB"/><Setter Property="Foreground" Value="#9CA3AF"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/><Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F9FAFB"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#9CA3AF"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#DC2626"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FECACA"/><Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FEF2F2"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#9CA3AF"/><Setter Property="BorderBrush" Value="#E5E7EB"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FLbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/><Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FInput" TargetType="Control">
            <Setter Property="Height" Value="34"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Margin="32,24,32,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left: table -->
        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="Date Produse" FontSize="22" FontWeight="Bold"
                           Foreground="#111827" VerticalAlignment="Center"/>
                <Border Background="#DBEAFE" BorderBrush="#93C5FD" BorderThickness="1"
                        Padding="10,3" Margin="12,0,0,0" CornerRadius="12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FilteredProducts.Count}"
                               Foreground="#1D4ED8" FontSize="12" FontWeight="Bold"/>
                </Border>
            </DockPanel>

            <!-- Toolbar -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                        CornerRadius="6" Padding="10,0" Height="34" Margin="0,0,10,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" Foreground="#111827" Background="Transparent"
                             BorderThickness="0" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SBtn}" Content="{DynamicResource Prod_Reload}"
                            Command="{Binding RefreshCommand}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource PBtn}" Content="{DynamicResource Prod_Add}"
                            Command="{Binding AddCommand}"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,6,0"/>
                    <Button Style="{StaticResource SBtn}" Content="{DynamicResource Prod_Edit}"
                            Command="{Binding EditCommand}"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,6,0"/>
                    <Button Style="{StaticResource DBtn}" Content="{DynamicResource Prod_Delete}"
                            Command="{Binding DeleteCommand}"
                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>

            <!-- Error -->
            <Border Grid.Row="2"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                    Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                    Padding="12,8" Margin="0,0,0,8" CornerRadius="6">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- Table -->
            <Border Grid.Row="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="10" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding FilteredProducts}"
                          SelectedItem="{Binding SelectedProduct}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"        Binding="{Binding Id}"           Width="55"/>
                        <DataGridTextColumn Header="Nume"      Binding="{Binding Name}"         Width="*"/>
                        <DataGridTextColumn Header="Categorie" Binding="{Binding Category}"     Width="110"/>
                        <DataGridTextColumn Header="Preț"      Binding="{Binding Price, StringFormat=C2}" Width="90"/>
                        <DataGridTextColumn Header="Stoc"      Binding="{Binding Stock}"        Width="65"/>
                        <DataGridTextColumn Header="Red.%"     Binding="{Binding DiscountPercentage, StringFormat='{}{0}%'}" Width="70"/>
                        <DataGridCheckBoxColumn Header="Ofertă" Binding="{Binding IsOnOffer}"   Width="60"/>
                        <DataGridTextColumn Header="Modificat" Binding="{Binding ModifiedDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Loading -->
            <Grid Grid.Row="3" Background="#EFF6FF" Opacity="0.85"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <ProgressBar Width="200" Height="3" IsIndeterminate="True" VerticalAlignment="Center"
                             Foreground="#2563EB" Background="Transparent" BorderThickness="0"/>
            </Grid>

            <TextBlock Grid.Row="4" Margin="0,8,0,0" Text="{Binding StatusMessage}"
                       Foreground="#9CA3AF" FontSize="11"/>
        </Grid>

        <!-- Right: form panel -->
        <Border Grid.Column="1"
                Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}"
                Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="10" Width="276" VerticalAlignment="Stretch" Padding="18,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="{Binding FormTitle}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#111827" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="✕" Width="26" Height="26"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#9CA3AF" Cursor="Hand"
                                Command="{Binding CancelFormCommand}"/>
                    </DockPanel>

                    <TextBlock Text="{DynamicResource Prod_Name}" Style="{StaticResource FLbl}"/>
                    <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FInput}" Margin="0,0,0,10"/>

                    <TextBlock Text="{DynamicResource Prod_Category}" Style="{StaticResource FLbl}"/>
                    <TextBox Text="{Binding FormCategory, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FInput}" Margin="0,0,0,10"/>

                    <TextBlock Text="{DynamicResource Prod_Price}" Style="{StaticResource FLbl}"/>
                    <TextBox Text="{Binding FormPrice, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FInput}" Margin="0,0,0,10"/>

                    <TextBlock Text="{DynamicResource Prod_Stock}" Style="{StaticResource FLbl}"/>
                    <TextBox Text="{Binding FormStock, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FInput}" Margin="0,0,0,10"/>

                    <TextBlock Text="{DynamicResource Prod_Description}" Style="{StaticResource FLbl}"/>
                    <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12" Background="White" Foreground="#111827"
                             BorderBrush="#D1D5DB" BorderThickness="1"
                             Padding="10,8" Height="56" TextWrapping="Wrap"
                             AcceptsReturn="True" Margin="0,0,0,10"/>

                    <TextBlock Text="{DynamicResource Prod_Image}" Style="{StaticResource FLbl}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Preview imagine curentă -->
                        <Border Grid.Row="0"
                                Width="120" Height="90"
                                HorizontalAlignment="Left"
                                BorderBrush="#D1D5DB" BorderThickness="1"
                                CornerRadius="6" Margin="0,0,0,6"
                                Background="#F9FAFB">
                            <Grid>
                                <!-- Placeholder când nu există imagine -->
                                <TextBlock Text="{DynamicResource Prod_NoImage}"
                                           Foreground="#9CA3AF" FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding FormImageData, Converter={StaticResource InvBoolToVis}, ConverterParameter=bytes}"/>
                                <Image Source="{Binding FormImageData, Converter={StaticResource BytesToImage}}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>

                        <!-- Rând: numele fișierului + buton Browse -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource FInput}"
                                     Text="{Binding FormImageFileName, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Foreground="#6B7280"
                                     ToolTip="Apasă 📂 pentru a selecta o imagine de pe calculator"/>
                            <Button Grid.Column="2"
                                    Style="{StaticResource SBtn}"
                                    Content="{DynamicResource Prod_ChooseImg}"
                                    Padding="10,0"
                                    Command="{Binding BrowseImageCommand}"/>
                        </Grid>
                    </Grid>

                    <TextBlock Text="{DynamicResource Prod_Discount}" Style="{StaticResource FLbl}"/>
                    <TextBox Text="{Binding FormDiscount, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FInput}" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <CheckBox IsChecked="{Binding FormIsOnOffer}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="În ofertă" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                            Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            Padding="10,8" Margin="0,0,0,10" CornerRadius="6">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="11" TextWrapping="Wrap"/>
                    </Border>

                    <Button Content="{DynamicResource Prod_Save}" Style="{StaticResource PBtn}"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}"
                            Margin="0,0,0,8"/>
                    <Button Content="{DynamicResource Prod_Cancel}" Style="{StaticResource SBtn}"
                            Command="{Binding CancelFormCommand}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
