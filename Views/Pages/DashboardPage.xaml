<Page x:Class="Wpf.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#EFF6FF" Title="Dashboard">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">
            <TextBlock Text="{Binding WelcomeMessage}" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
            <TextBlock Text="{Binding UserRoleDescription}" Foreground="#6B7280" FontSize="13" Margin="0,3,0,28"/>

            <UniformGrid Columns="4" Margin="0,0,0,28">
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="PRODUSE" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ProductCount}" FontSize="32" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="{DynamicResource Dash_InStock}" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="COMENZI" FontSize="10" FontWeight="Bold" Foreground="#D97706" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding OrderCount}" FontSize="32" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="{DynamicResource Dash_Orders}" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,12,0"
                        Visibility="{Binding CanViewUsers, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="UTILIZATORI" FontSize="10" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding UserCount}" FontSize="32" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="{DynamicResource Dash_Registered}" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="VALOARE STOC" FontSize="10" FontWeight="Bold" Foreground="#059669" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TotalValue, StringFormat=C2}" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="{DynamicResource Dash_Total}" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Separator Background="#E5E7EB" Margin="0,0,0,22"/>

            <!-- Token info -->
            <TextBlock Text="{DynamicResource Dash_ActiveToken}" FontSize="13" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,14"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Dash_User}" Foreground="#6B7280" FontSize="13" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TokenUsername}" Foreground="#111827" FontSize="13" FontWeight="Medium" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Dash_Role}"       Foreground="#6B7280" FontSize="13" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TokenRole}"     Foreground="#111827" FontSize="13" FontWeight="Medium" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Dash_Expires}" Foreground="#6B7280" FontSize="13"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TokenExpiry}"   Foreground="#D97706" FontSize="13" FontWeight="Medium"/>
            </Grid>

            <Separator Background="#E5E7EB" Margin="0,20,0,20"/>
            <TextBlock Text="{DynamicResource Dash_SQLServer}" FontSize="13" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding DbVersion}" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"/>

            <ProgressBar Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         IsIndeterminate="True" Height="3" Margin="0,18,0,0"
                         Foreground="#2563EB" Background="Transparent" BorderThickness="0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
