<Page x:Class="Wpf.Views.Pages.AdminDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:Wpf.Converters"
      Background="#EFF6FF" Title="Admin Dashboard">

    <Page.Resources>
        <Style x:Key="Tab" TargetType="Button">
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Padding"         Value="20,0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#6B7280"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#111827"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PBtn" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="#2563EB"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8"/></Trigger>
                <Trigger Property="IsEnabled"   Value="False"><Setter Property="Background" Value="#E5E7EB"/><Setter Property="Foreground" Value="#9CA3AF"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SBtn" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#D1D5DB"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F9FAFB"/></Trigger>
                <Trigger Property="IsEnabled"   Value="False"><Setter Property="Foreground" Value="#9CA3AF"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DBtn" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#FECACA"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FEF2F2"/></Trigger>
                <Trigger Property="IsEnabled"   Value="False"><Setter Property="Foreground" Value="#9CA3AF"/><Setter Property="BorderBrush" Value="#E5E7EB"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FInput" TargetType="Control">
            <Setter Property="Height"                   Value="34"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#111827"/>
            <Setter Property="BorderBrush"              Value="#D1D5DB"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#111827"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="RowBackground"            Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6"/>
            <Setter Property="ColumnHeaderHeight"       Value="38"/>
            <Setter Property="RowHeight"                Value="36"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="SelectionMode"            Value="Single"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#F9FAFB"/>
            <Setter Property="Foreground"      Value="#6B7280"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="#E5E7EB"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">

            <!-- Header -->
            <TextBlock Text="{DynamicResource Admin_Title}" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
            <TextBlock Text="{DynamicResource Admin_Manage}" Foreground="#6B7280" FontSize="13" Margin="0,3,0,24"/>

            <!-- Tabs -->
            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Button Tag="Products" Content="{DynamicResource Admin_Products}"
                            Command="{Binding SwitchTabCommand}" CommandParameter="Products">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Tab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Products">
                                        <Setter Property="Foreground"   Value="#1D4ED8"/>
                                        <Setter Property="BorderBrush"  Value="#1D4ED8"/>
                                        <Setter Property="FontWeight"   Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Tag="Users" Content="{DynamicResource Admin_Users}"
                            Command="{Binding SwitchTabCommand}" CommandParameter="Users">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Tab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Users">
                                        <Setter Property="Foreground"   Value="#1D4ED8"/>
                                        <Setter Property="BorderBrush"  Value="#1D4ED8"/>
                                        <Setter Property="FontWeight"   Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>


            <!-- ═══ PRODUCTS TAB ═══ -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource StrEq}, ConverterParameter=Products}">

                <!-- Form -->
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                        CornerRadius="10" Padding="22,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Prod_FormTitle}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#111827" Margin="0,0,0,18"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="{DynamicResource Prod_Name}" Style="{StaticResource Lbl}"/>
                                <TextBox Style="{StaticResource FInput}" Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="{DynamicResource Prod_Category}" Style="{StaticResource Lbl}"/>
                                <TextBox Style="{StaticResource FInput}" Text="{Binding ProductCategory, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                <TextBlock Text="{DynamicResource Prod_Price}" Style="{StaticResource Lbl}"/>
                                <TextBox Style="{StaticResource FInput}" Text="{Binding ProductPrice, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                <TextBlock Text="{DynamicResource Prod_Stock}" Style="{StaticResource Lbl}"/>
                                <TextBox Style="{StaticResource FInput}" Text="{Binding ProductStock, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                <TextBlock Text="{DynamicResource Prod_Description}" Style="{StaticResource Lbl}"/>
                                <TextBox Style="{StaticResource FInput}" Height="64"
                                         Text="{Binding ProductDescription, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalContentAlignment="Top" Padding="10,8"/>
                            </StackPanel>

                            <!-- Image picker -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                <TextBlock Text="{DynamicResource Prod_ImagePreview}" Style="{StaticResource Lbl}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource FInput}"
                                             Text="{Binding ProductImageFileName, Mode=OneWay}"
                                             IsReadOnly="True" Foreground="#6B7280"/>
                                    <Button Grid.Column="2" Style="{StaticResource SBtn}"
                                            Content="{DynamicResource Prod_Choose}" Width="100"
                                            Command="{Binding BrowseImageCommand}"/>
                                </Grid>
                                <!-- Preview -->
                                <Border Margin="0,8,0,0" Height="80" Width="80" HorizontalAlignment="Left"
                                        CornerRadius="6" BorderBrush="#E5E7EB" BorderThickness="1"
                                        Visibility="{Binding ProductImageData, Converter={StaticResource BoolToVis}}"
                                        ClipToBounds="True">
                                    <Image Source="{Binding ProductImageData, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,12,0,0">
                                <TextBlock Text="{DynamicResource Prod_Discount}" Style="{StaticResource Lbl}"/>
                                <TextBox Style="{StaticResource FInput}" Text="{Binding ProductDiscount, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,12,0,0" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding ProductIsOnOffer}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Ofertă specială" FontSize="13" Foreground="#374151" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                                        Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="{DynamicResource Prod_AddRow}"     Style="{StaticResource PBtn}" Command="{Binding AddProductCommand}"    Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource Prod_Update}" Style="{StaticResource SBtn}" Command="{Binding UpdateProductCommand}" Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource Prod_DeleteRow}"      Style="{StaticResource DBtn}" Command="{Binding DeleteProductCommand}" Margin="0,0,8,0"/>
                                <Button Content="Golește"        Style="{StaticResource SBtn}" Command="{Binding ClearProductFormCommand}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Products table -->
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                        CornerRadius="10" ClipToBounds="True">
                    <StackPanel>
                        <Border Padding="18,12" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                            <TextBlock Text="{DynamicResource Prod_TitleData}" FontSize="13" FontWeight="SemiBold" Foreground="#111827"/>
                        </Border>
                        <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                                  AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300"
                                  MouseDoubleClick="DataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"       Binding="{Binding Id}"          Width="55"/>
                                <DataGridTextColumn Header="Nume"     Binding="{Binding Name}"        Width="*"/>
                                <DataGridTextColumn Header="Cat."     Binding="{Binding Category}"    Width="100"/>
                                <DataGridTextColumn Header="Preț"     Binding="{Binding Price, StringFormat=C2}" Width="90"/>
                                <DataGridTextColumn Header="Stoc"     Binding="{Binding Stock}"       Width="60"/>
                                <DataGridTextColumn Header="Red.%"    Binding="{Binding DiscountPercentage, StringFormat='{}{0}%'}" Width="70"/>
                                <DataGridCheckBoxColumn Header="Ofertă" Binding="{Binding IsOnOffer}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══ USERS TAB ═══ -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource StrEq}, ConverterParameter=Users}">

                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Utilizatori" FontSize="13" FontWeight="SemiBold"
                               Foreground="#111827" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right"
                            Content="{DynamicResource Users_AddUser}"
                            Style="{StaticResource PBtn}"
                            Command="{Binding AddUserCommand}" Width="355"/>
                </DockPanel>

                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                        CornerRadius="10" Padding="22,20" Margin="0,0,0,16"
                        Visibility="{Binding IsUserFormVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Users_FormTitle}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#111827" Margin="0,0,0,18"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="{DynamicResource Reg_Username}" Style="{StaticResource Lbl}"/>
                                <TextBox Style="{StaticResource FInput}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="{DynamicResource Reg_Email}" Style="{StaticResource Lbl}"/>
                                <TextBox Style="{StaticResource FInput}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                <TextBlock Text="{DynamicResource Reg_Role}" Style="{StaticResource Lbl}"/>
                                <ComboBox Style="{StaticResource FInput}"
                                          ItemsSource="{Binding Roles}"
                                          SelectedItem="{Binding SelectedRole, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Câmpuri parolă — vizibile doar la creare utilizator nou -->
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0"
                                        Visibility="{Binding IsCreatingUser, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource Reg_Password}" Style="{StaticResource Lbl}"/>
                                <PasswordBox x:Name="PbxUserPassword" Style="{StaticResource FInput}"
                                             PasswordChanged="PbxUserPassword_Changed"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0"
                                        Visibility="{Binding IsCreatingUser, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource Reg_ConfirmPassword}" Style="{StaticResource Lbl}"/>
                                <PasswordBox x:Name="PbxUserPasswordConfirm" Style="{StaticResource FInput}"
                                             PasswordChanged="PbxUserPasswordConfirm_Changed"/>
                                <!-- Avertisment nepotrivire -->
                                <TextBlock Text="Parolele nu coincid!"
                                           Foreground="#DC2626" FontSize="11" Margin="0,4,0,0"
                                           Visibility="{Binding PasswordMismatch, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0"
                                        Visibility="{Binding IsCreatingUser, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"
                                           Text="Parola trebuie să aibă minim 6 caractere."/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                        Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="{DynamicResource Prod_AddRow}"    Style="{StaticResource PBtn}" Command="{Binding AddUserCommand}"    Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource Prod_Update}"    Style="{StaticResource SBtn}" Command="{Binding UpdateUserCommand}" Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource Prod_DeleteRow}" Style="{StaticResource DBtn}" Command="{Binding DeleteUserCommand}" Margin="0,0,8,0"/>
                                <Button Content="Golește"                          Style="{StaticResource SBtn}" Command="{Binding ClearUserFormCommand}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                        CornerRadius="10" ClipToBounds="True">
                    <StackPanel>
                        <Border Padding="18,12" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                            <TextBlock Text="{DynamicResource Admin_UserList}" FontSize="13" FontWeight="SemiBold" Foreground="#111827"/>
                        </Border>
                        <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                                  AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="520"
                                  MouseDoubleClick="DataGrid_Users_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"       Binding="{Binding Id}"         Width="55"/>
                                <DataGridTextColumn Header="{DynamicResource Admin_ColUsername}" Binding="{Binding Username}"   Width="140"/>
                                <DataGridTextColumn Header="{DynamicResource Admin_ColEmail}"    Binding="{Binding Email}"      Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource Admin_ColRole}"      Binding="{Binding Role}"       Width="120"/>
                                <DataGridCheckBoxColumn Header="Activ" Binding="{Binding IsActive}"  Width="60"/>
                                <DataGridTextColumn Header="Creat"    Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Loading -->
            <ProgressBar Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         IsIndeterminate="True" Height="3" Margin="0,18,0,0"
                         Foreground="#2563EB" Background="Transparent" BorderThickness="0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
