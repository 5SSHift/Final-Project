<Window x:Class="Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Wpf.Converters"
        Title="ShopManager" Height="700" Width="1150"
        Icon="/Resources/icon.ico"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Background="#EFF6FF">

    <!-- WindowChrome: păstrează resize + drag, elimină bara Windows implicită -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Buton bară titlu (min/max/close) -->
        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="#6B7280"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Width"            Value="46"/>
            <Setter Property="Height"           Value="44"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Buton Close — hover roșu -->
        <Style x:Key="TitleBarCloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav button styles -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="#4B5563"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Height"                     Value="42"/>
            <Setter Property="Padding"                    Value="18,0"/>
            <Setter Property="FontSize"                   Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavBtnActive" TargetType="Button" BasedOn="{StaticResource NavBtn}">
            <Setter Property="Background" Value="#DBEAFE"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>  <!-- bara de titlu custom -->
            <RowDefinition Height="*"/>   <!-- conținut -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ BARA DE TITLU CUSTOM ═══ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="White"
                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <DockPanel>

                <!-- Butoane Min / Max / Close -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Stretch">
                    <Button Style="{StaticResource TitleBarBtn}"
                            Content="🗕" FontSize="11"
                            Click="OnMinimize" ToolTip="Minimizează"/>
                    <Button Style="{StaticResource TitleBarBtn}"
                            x:Name="BtnMaxRestore"
                            Content="🗖" FontSize="11"
                            Click="OnMaximizeRestore" ToolTip="Maximizează / Restaurează"/>
                    <Button Style="{StaticResource TitleBarCloseBtn}"
                            Content="✕" FontSize="12"
                            Click="OnClose" ToolTip="Închide"/>
                </StackPanel>

                <!-- Icon mare + titlu -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0">
                    <Image Source="/Resources/icon.ico"
                           Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                    <TextBlock Text="ShopManager"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#111827"
                               VerticalAlignment="Center"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ═══ SIDEBAR ═══ -->
        <Border Grid.Row="1" Grid.Column="0" Background="White"
                BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Brand + user -->
                <StackPanel DockPanel.Dock="Top" Margin="18,24,18,20">
                    <TextBlock Text="ShopManager" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="{Binding UserInfo}" Foreground="#6B7280" FontSize="11" Margin="0,4,0,0"/>
                    <!-- Role pill -->
                    <Border Margin="0,8,0,0" HorizontalAlignment="Left" Padding="8,3" CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#DBEAFE"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentRole}" Value="Administrator">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentRole}" Value="Employee">
                                        <Setter Property="Background" Value="#F0FDF4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding CurrentRole}" FontSize="10" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentRole}" Value="Administrator">
                                            <Setter Property="Foreground" Value="#DC2626"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentRole}" Value="Employee">
                                            <Setter Property="Foreground" Value="#16A34A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <Separator DockPanel.Dock="Top" Background="#F3F4F6"/>

                <!-- Logout -->
                <Button DockPanel.Dock="Bottom"
                        Content="{DynamicResource Nav_Logout}" Margin="0,0,0,12"
                        Command="{Binding LogoutCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                            <Setter Property="Foreground" Value="#EF4444"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FEF2F2"/>
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- DB status -->
                <Separator DockPanel.Dock="Bottom" Background="#F3F4F6" Margin="0,0,0,4"/>

                <!-- Nav items -->
                <StackPanel Margin="0,8,0,0">

                    <!-- Admin only -->
                    <Button x:Name="BtnAdminDash" Content="{DynamicResource Nav_AdminDash}"
                            Command="{Binding NavAdminDashboardCommand}"
                            Visibility="{Binding ShowAdminDashboard, Converter={StaticResource BoolToVis}}"/>
                    <Button x:Name="BtnDashboard" Content="{DynamicResource Nav_Dashboard}"
                            Command="{Binding NavDashboardCommand}"
                            Visibility="{Binding ShowDashboard, Converter={StaticResource BoolToVis}}"/>

                    <!-- All roles — shop -->
                    <Button x:Name="BtnClientProducts" Content="{DynamicResource Nav_Shop}"
                            Command="{Binding NavClientProductsCommand}"/>

                    <!-- Cart with live badge -->
                    <Button x:Name="BtnCart" Command="{Binding NavCartCommand}"
                            HorizontalContentAlignment="Left">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavBtn}"/>
                        </Button.Style>
                        <DockPanel>
                            <TextBlock Text="{DynamicResource Nav_Cart}" VerticalAlignment="Center"/>
                            <Border DockPanel.Dock="Right"
                                    Background="#2563EB" CornerRadius="10"
                                    Padding="4,1" Margin="8,2,0,0"
                                    Height="20" MinWidth="20" VerticalAlignment="Center"
                                    Visibility="{Binding Cart.ItemCount, Converter={StaticResource GtZero}}">
                                <TextBlock Text="{Binding Cart.ItemCount}"
                                           Foreground="White" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </DockPanel>
                    </Button>

                    <!-- Employee + Admin -->
                    <Button x:Name="BtnProducts" Content="{DynamicResource Nav_Products}"
                            Command="{Binding NavProductsCommand}"
                            Visibility="{Binding ShowRawProducts, Converter={StaticResource BoolToVis}}"/>
                    <Button x:Name="BtnOrders" Content="{DynamicResource Nav_Orders}"
                            Command="{Binding NavOrdersCommand}"
                            Visibility="{Binding ShowOrders, Converter={StaticResource BoolToVis}}"/>

                    <!-- Admin only -->
                    <Button x:Name="BtnUsers" Content="{DynamicResource Nav_Users}"
                            Command="{Binding NavUsersCommand}"
                            Visibility="{Binding ShowUsers, Converter={StaticResource BoolToVis}}"/>

                    <!-- All roles -->
                    <Button x:Name="BtnSettings" Content="{DynamicResource Nav_Settings}"
                            Command="{Binding NavSettingsCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ CONTENT ═══ -->
        <Frame Grid.Row="1" Grid.Column="1" x:Name="MainFrame"
               NavigationUIVisibility="Hidden"
               Background="#EFF6FF"/>
    </Grid>
</Window>
