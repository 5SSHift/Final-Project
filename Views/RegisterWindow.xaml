<Window x:Class="Wpf.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Wpf.Converters"
        Title="ShopManager — Înregistrare"
        Height="663" Width="420"
        Icon="/Resources/icon.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EFF6FF">

    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <Style x:Key="Input" TargetType="Control">
            <Setter Property="Height"                   Value="40"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#111827"/>
            <Setter Property="BorderBrush"              Value="#D1D5DB"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" 
                                              Focusable="false" 
                                              HorizontalScrollBarVisibility="Hidden" 
                                              VerticalScrollBarVisibility="Hidden"
                                              VerticalAlignment="Center"
                                              Padding="{TemplateBinding Padding}"/>
                            </Border>

                            <TextBlock x:Name="PlaceholderText"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="#9CA3AF"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontStyle="Italic"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Margin="14,0,12,0"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Validation.HasError" Value="true">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#DC2626"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value=""/>
                                    <Condition Binding="{Binding IsFocused, RelativeSource={RelativeSource Self}}" Value="false"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value=""/>
                                    <Condition Binding="{Binding IsFocused, RelativeSource={RelativeSource Self}}" Value="true"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="PlaceholderText" Property="Opacity" Value="0.4"/>
                            </MultiDataTrigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Password, RelativeSource={RelativeSource Self}}" Value=""/>
                                    <Condition Binding="{Binding IsFocused, RelativeSource={RelativeSource Self}}" Value="false"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Password, RelativeSource={RelativeSource Self}}" Value=""/>
                                    <Condition Binding="{Binding IsFocused, RelativeSource={RelativeSource Self}}" Value="true"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="PlaceholderText" Property="Opacity" Value="0.4"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height"          Value="40"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="#2563EB"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E5E7EB"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="0,0,0,69">
        <Border VerticalAlignment="Top" Height="3" Background="#2563EB"/>

        <Border Background="White" Margin="32,32,32,-33" CornerRadius="10"
                BorderBrush="#E5E7EB" BorderThickness="1"
                Padding="36,32">
            <StackPanel>
                <TextBlock Text="{DynamicResource App_Name}" FontSize="20" FontWeight="Bold"
                           Foreground="#111827" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Reg_Title}"
                           FontSize="12" Foreground="#6B7280"
                           HorizontalAlignment="Center" Margin="0,4,0,24"/>

                <TextBlock Text="Username" Style="{StaticResource Lbl}"/>
                <TextBox Style="{StaticResource Input}"
                         Tag="Vlad_Fulga"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Email" Style="{StaticResource Lbl}"/>
                <TextBox Style="{StaticResource Input}"
                         Tag="calin.bobeico06@gmail.com"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <TextBlock Text="{DynamicResource Reg_Password}" Style="{StaticResource Lbl}"/>
                <PasswordBox x:Name="PbxRegPass"
                             Style="{StaticResource Input}" 
                             Margin="0,0,0,12"/>

                <TextBlock Text="{DynamicResource Reg_ConfirmPassword}" Style="{StaticResource Lbl}"/>
                <PasswordBox x:Name="PbxConfirm" 
                             Style="{StaticResource Input}" 
                             Margin="0,0,0,12"/>

                <Button Content="{DynamicResource Reg_Button}" Style="{StaticResource PrimaryBtn}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}"
                        Click="BtnRegister_Click"/>

                <ProgressBar Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             IsIndeterminate="True" Height="2" Margin="0,8,0,0"
                             Foreground="#2563EB" Background="Transparent" BorderThickness="0"/>

                <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                        Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                        Padding="12,8" Margin="0,10,0,0" CornerRadius="6">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626"
                               FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <Border Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVis}}"
                        Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                        Padding="12,8" Margin="0,10,0,0" CornerRadius="6">
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#16A34A"
                               FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0"
                           FontSize="12" Foreground="#6B7280">
                    Ai deja cont?&#160;
                    <Hyperlink Foreground="#2563EB" Command="{Binding OpenLoginCommand}">
                        Autentifică-te
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
