<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="DefaultConnection"
         connectionString="Server=DESKTOP-VQDORJ8\SQLEXPRESS01;Database=Practica;Trusted_Connection=true;TrustServerCertificate=true;Connection Timeout=15;MultipleActiveResultSets=true;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="Database:AutoInitialize" value="true" />
    <add key="Database:CommandTimeout"  value="30" />
    <!-- SMTP pentru trimitere OTP (configurează cu datele tale) -->
    <add key="Smtp:Host"        value="smtp.gmail.com" />
    <add key="Smtp:Port"        value="587" />
    <add key="Smtp:EnableSsl"   value="true" />
    <add key="Smtp:Username"    value="adresa_ta@gmail.com" />
    <add key="Smtp:Password"    value="parola_aplicatie_gmail" />
    <add key="Smtp:FromName"    value="Product Manager" />
    <!-- OTP expiră după N minute -->
    <add key="Otp:ExpiryMinutes" value="5" />
  </appSettings>
</configuration>
